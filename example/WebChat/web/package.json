{
  "name": "webchat-example",
  "version": "0.0.0",
  "private": true,
  "description": "hgmRoomNotify WebChat 例子的 React 前端. 浏览器客户端 TS 在编译前由 prebuild 钩子复制进 src(已 gitignore), 仓库不留第二份.",
  "scripts": {
    "copy-client": "node scripts/copy-client.mjs",
    "prebuild": "npm run copy-client",
    "build": "esbuild src/main.tsx --bundle --outfile=dist/app.js --format=iife --jsx=automatic --define:process.env.NODE_ENV='\"production\"'",
    "predev": "npm run copy-client",
    "dev": "esbuild src/main.tsx --bundle --outfile=dist/app.js --format=iife --jsx=automatic --define:process.env.NODE_ENV='\"development\"' --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
